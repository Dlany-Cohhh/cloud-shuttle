# 复制为 .env 后按实际环境修改。.env 已被 .gitignore 忽略，切勿提交。
# 建议全部使用绝对路径（docker compose 会从 compose 文件所在目录解析相对路径）。
# 更省事的做法是直接跑一键部署脚本，它会问几个问题并生成好本文件：
#   Linux / macOS : bash scripts/deploy.sh
#   Windows       : 双击 scripts\deploy.bat（或 powershell -File scripts\deploy.ps1）

# PikPak 多账号下载器（云梭 CloudShuttle）项目根目录（含 download-console.py 与 static/），会以读写方式挂到容器 /app。
# 运行时数据 jobs.json / settings.json / accounts_meta.json 也写在这里。
PROJECT_ROOT=./

# 下载落盘目录：控制台挂到 /vol2/download，rclone-backend 挂到 /data。
# 两处必须指向宿主机同一个目录，否则「本地文件」页看到的内容和实际下载不一致。
DOWNLOAD_ROOT=/path/to/downloads

# rclone.conf 所在目录（容器内为 /config/rclone）。
# rclone.conf 含所有账号的 refresh_token，绝不能放进仓库。
RCLONE_CONFIG_DIR=/path/to/rclone/config

# rclone RC 凭据：控制台与 rclone-backend 必须使用同一组值。
# 请改成自己的随机字符串，不要沿用示例值。
RCLONE_RC_USER=change-me
RCLONE_RC_PASS=change-me-to-a-long-random-string

# ── 代理地址（v3.55，可自定义）────────────────────────────────────
# 代理下载 / 分享链接走这个地址；支持 http:// https:// socks5:// socks5h://。
# 留空或删掉则用默认 http://127.0.0.1:7890；填 off / none / direct = 完全不走代理。
# 也可以用别的代理客户端，不要求一定跑 mihomo 容器。
# Windows Docker Desktop 访问宿主机上的代理客户端：http://host.docker.internal:7890
# 页面「设置 → 代理下载 → 自定义代理地址」的值优先于这里，改完立即生效（无需重启）。
PROXY_URL=http://127.0.0.1:7890

# Windows 版端口映射用（docker-compose.windows.yml）；Linux host 网络下固定 5566。
WEB_PORT=5566

# 采集脚本回推地址；留空按浏览器 Host 头判断，反代场景可填 域名:端口。
CONSOLE_PUBLIC_HOST=localhost:5566

# 可选扩展服务的凭据（不启用 OpenList / aria2 时可忽略）
OPENLIST_ADMIN_PASSWORD=change-me
ARIA2_RPC_SECRET=change-me

# ── 在线检查更新（v3.54，可选）──────────────────────────────────
# 换成自己的 fork 即可跟随自己的发行版；私有仓库或想提高 API 限额时填 GITHUB_TOKEN。
UPDATE_REPO=Dlany-Cohhh/cloud-shuttle
UPDATE_AUTO_RESTART=1
# GITHUB_TOKEN=
